+        path, why = remote_data.refresh_db(("main",), get=lambda *a, **k: Resp(old), dest_dir=self.tmp)
+        self.assertIsNone(path)
+        self.assertEqual(config.DB_PATH, self.bundled)
+
+    def test_corrupt_download_is_refused(self):
